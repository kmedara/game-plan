{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules",
      "cdk.out"
    ]
  },
  "context": {
    "callbackUrls": ["http://localhost:3000/identity/oauth/callback"],
    "logoutUrls": ["http://localhost:4200/", "http://localhost:4200/login"]
  }
}
