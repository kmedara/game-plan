# syntax=docker/dockerfile:1
#
# Local client image: Expo web (Compose Watch syncs ./client).
# Installs only lib/types, lib/rules, and client/* — skips schemas, functions, local, and infrastructure.

FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
COPY lib/types/package.json ./lib/types/package.json
COPY lib/rules/package.json ./lib/rules/package.json
COPY client/expo/package.json ./client/expo/package.json
COPY client/session/package.json ./client/session/package.json

RUN --mount=type=cache,target=/root/.npm \
  node -e "const fs=require('fs'); const p=JSON.parse(fs.readFileSync('package.json','utf8')); p.workspaces=['lib/types','lib/rules','client/*']; fs.writeFileSync('package.json', JSON.stringify(p, null, 2));" \
  && npm install --no-audit --no-fund

COPY client ./client
COPY lib/types ./lib/types
COPY lib/rules ./lib/rules

EXPOSE 4200 8081

ENV EXPO_NO_TELEMETRY=1

CMD ["npm", "start", "-w", "@gameplan/expo", "--", "--web", "--port", "4200", "--host", "lan"]
