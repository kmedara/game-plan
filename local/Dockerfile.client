# syntax=docker/dockerfile:1
#
# Local client image: Angular ng serve (Compose Watch syncs ./client).
# Installs only lib/types and client/* — skips schemas, functions, local, and infrastructure.

FROM node:22-bookworm-slim

WORKDIR /app

# Manifests only — source COPY comes after install so code edits keep the install layer.
COPY package.json package-lock.json ./
COPY lib/types/package.json ./lib/types/package.json
COPY client/app/package.json ./client/app/package.json
COPY client/session/package.json ./client/session/package.json

# Filtered workspaces no longer match the full lockfile, so use npm install (not npm ci).
RUN --mount=type=cache,target=/root/.npm \
  node -e "const fs=require('fs'); const p=JSON.parse(fs.readFileSync('package.json','utf8')); p.workspaces=['lib/types','client/*']; fs.writeFileSync('package.json', JSON.stringify(p, null, 2));" \
  && npm install --no-audit --no-fund

COPY client ./client
COPY lib/types ./lib/types
COPY config ./config

ENV API_BASE_URL=http://localhost:3000
ENV WS_BASE_URL=ws://localhost:3000/socket
ENV AUTH_DISABLED=true

EXPOSE 4200 49153

CMD ["npm", "start", "-w", "@gameplan/app", "--", "--host", "0.0.0.0", "--port", "4200"]
