{
  "name": "gameplan",
  "private": true,
  "type": "module",
  "workspaces": [
    "lib/*",
    "functions/*",
    "local",
    "infrastructure",
    "client/*"
  ],
  "scripts": {
    "dev": "tsx local/src/dev.ts",
    "db:up": "docker compose up -d dynamodb",
    "db:create": "tsx local/src/create-table.ts",
    "db:seed": "tsx local/src/seed-demo-teams.ts --reset",
    "up": "docker compose up --watch",
    "env:local": "node fetch-local-env.mjs",
    "up:build": "docker compose up --build --watch",
    "down": "docker compose down",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:app": "npm test -w @gameplan/expo",
    "generate:types": "tsx lib/schemas/scripts/generate-types.ts",
    "typecheck": "npm run generate:types && tsc -p tsconfig.json --noEmit && tsc -p infrastructure/tsconfig.json --noEmit && tsc -p client/session/tsconfig.json --noEmit && npm run typecheck -w @gameplan/expo",
    "client:start": "npm start -w @gameplan/expo -- --web --port 4200",
    "client:build": "npm run build -w @gameplan/expo",
    "inspect:api": "node scripts/inspect-bundles.mjs api",
    "inspect:client": "node scripts/inspect-bundles.mjs client",
    "local-dynamo": "npx dynamodb-admin --dynamo-endpoint http://localhost:8000",
    "synth": "npm run synth -w @gameplan/infrastructure",
    "sync:stripe-webhook-ips": "node infrastructure/scripts/sync-stripe-webhook-ips.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.16.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "json-schema-to-typescript": "^16.0.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
