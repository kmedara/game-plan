{
  "expo": {
    "name": "GamePlan",
    "slug": "gameplan",
    "scheme": "gameplan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "default": true
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0a6e38"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GamePlan uses your photo library when you pick a team logo, a profile picture, or a file to share in chat.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0a6e38"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "bundleIdentifier": "com.gameplan.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gameplan.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a6e38"
      }
    },
    "extra": {
      "eas": {
        "projectId": "fa70eb6b-e8c0-44c7-b9c8-a6c731d14f11"
      },
      "router": {}
    },
    "owner": "kmedaras-team"
  }
}
