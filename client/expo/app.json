{
  "expo": {
    "name": "GamePlan",
    "slug": "gameplan",
    "scheme": "gameplan",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0a6e38"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "bundleIdentifier": "com.gameplan.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.gameplan.app"
    },
    "extra": {
      "eas": {
        "projectId": "fa70eb6b-e8c0-44c7-b9c8-a6c731d14f11"
      },
      "router": {}
    },
    "owner": "kmedaras-team"
  }
}